# Copy to .env for local dev. On Railway, set these as service Variables instead.

# REQUIRED. Long random string the app sends as the X-API-Key header.
PROXY_API_KEY=change-me-to-a-long-random-string

# Garmin login. Only needed for the one-time /garmin/login bootstrap.
# You can leave these blank and pass them in the login request body instead.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Paths. Defaults point at the Railway Volume mount (/data).
# For LOCAL dev, override to a writable folder, e.g. ./data
GARMIN_TOKEN_DIR=/data/garmin_tokens
DB_PATH=/data/garmin.db

# Cadence / locale
POLL_INTERVAL_MINUTES=30
TIMEZONE=America/New_York
ACTIVITIES_LIMIT=5
